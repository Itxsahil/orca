# Copy to .env and adjust. Read by the api and the db scripts.
DATABASE_URL=postgres://app:app@localhost:5432/app

API_PORT=3000
# Origins allowed to call the API from a browser (comma-separated). In dev the
# Vite server proxies /rpc to the API, so this only matters for other origins.
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Public URL of the web app (invite links point here).
APP_URL=http://localhost:5173
# The only email allowed to create the first account (the platform admin), once.
PLATFORM_ADMIN_EMAIL=you@example.com
# invite: accounts only via invite links. closed: no new accounts at all (even with an invite).
SIGNUP_MODE=invite
# SESSION_TTL_DAYS=30
# INVITE_TTL_DAYS=7
# Secure cookies: on by default when NODE_ENV=production. Must be on behind https.
# COOKIE_SECURE=true
# Behind a reverse proxy, so rate limits see the real client IP (e.g. 1).
# TRUST_PROXY=1
