# Copy to .env and adjust. Read by the api and the db scripts.
DATABASE_URL=postgres://app:app@localhost:5432/app
# Sessions and rate limits (and later queues, caches, ...).
REDIS_URL=redis://localhost:6379

API_PORT=3000
# Origins allowed to call the API from a browser (comma-separated). In dev the
# Vite server proxies /rpc to the API, so this only matters for other origins.
CORS_ORIGIN=http://localhost:5173

# ---- Auth ----
# Public URL of the web app (invite links point here).
APP_URL=http://localhost:5173
# The only email allowed to create the first account (the platform admin), once.
PLATFORM_ADMIN_EMAIL=you@example.com
# invite: accounts only via invite links. closed: no new accounts at all (even with an invite).
SIGNUP_MODE=invite
# SESSION_TTL_DAYS=30
# INVITE_TTL_DAYS=7
# Secure cookies: on by default when NODE_ENV=production. Must be on behind https.
# COOKIE_SECURE=true
# Behind a reverse proxy, so rate limits see the real client IP (e.g. 1).
# TRUST_PROXY=1

# Public URL of the API (upload URLs handed to clients point here).
API_PUBLIC_URL=http://localhost:3000

# ---- Video storage: Cloudflare R2 ----
# Production: R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and an R2 API token's
# access key / secret. Local dev: the SeaweedFS container from docker-compose (any keys work).
R2_ENDPOINT=http://localhost:8333
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
# Both buckets are private: uploads go through the API and playback uses presigned URLs.
R2_SOURCE_BUCKET=videos-source
R2_DELIVERY_BUCKET=videos-delivery
# MAX_UPLOAD_BYTES=32212254720   # 30 GiB, the Cloudflare Stream limit

# ---- Email (Resend) ----
# Used to email invite links. Leave empty to skip emails and copy links from /admin instead.
# Get a key at https://resend.com.
RESEND_API_KEY=
# Sender address. Resend's test sender (onboarding@resend.dev) can only email your own Resend
# account address; verify your domain in Resend to email anyone.
EMAIL_FROM=Video Platform <onboarding@resend.dev>
