{
  "name": "orca",
  "version": "0.1.0",
  "description": "Deploy apps to your VPS with Docker",
  "main": "dist/bin/orca.js",
  "bin": {
    "orca": "dist/bin/orca.js"
  },
  "scripts": {
    "dev": "ts-node bin/orca.ts",
    "build": "tsc",
    "start": "node dist/bin/orca.js",
    "clean": "rm -rf dist",
    "bl": "npm run build && npm link",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "deploy",
    "vps",
    "docker",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "ioredis": "^5.10.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ssh2": "^1.15.0",
    "@types/yaml": "^1.9.6",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
